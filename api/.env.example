# Postgres (docker-compose local)
DATABASE_URL="postgresql://contahora:contahora@localhost:5432/contahora?schema=public"

# JWT
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="7d"

# Admin criado pelo `npm run seed`
ADMIN_EMAIL="admin@contahora.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# CORS - origem do front (separe por virgula se tiver mais de uma)
WEB_ORIGIN="http://localhost:5173"

# Porta (Railway injeta PORT automaticamente)
PORT=3000
