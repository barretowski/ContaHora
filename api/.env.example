# Postgres (docker-compose local - porta 5433 p/ nao conflitar com Postgres nativo)
DATABASE_URL="postgresql://contahora:contahora@localhost:5433/contahora?schema=public"

# JWT
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="7d"

# Admin criado pelo `npm run seed`
ADMIN_EMAIL="admin@contahora.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# CORS - origem do front (separe por virgula se tiver mais de uma)
WEB_ORIGIN="http://localhost:5173"

# Cadastro aberto na tela de login (true/false). "false" bloqueia /auth/register e /auth/google de contas novas
REGISTRATION_OPEN="true"

# E-mails que viram ADMIN automaticamente no login, inclusive via Google (separe por virgula)
ADMIN_EMAILS=""

# Rate limiting: ja vem ligado (120 req/min geral, 8/min nas rotas de /auth). Sem env.

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth 2.0 - tipo "Aplicativo Web")
# Mesmo valor vai no web/.env como VITE_GOOGLE_CLIENT_ID. Vazio = botao do Google escondido.
GOOGLE_CLIENT_ID=""

# URL publica do front, usada nos links dos e-mails (default: 1o valor de WEB_ORIGIN)
APP_WEB_URL="http://localhost:5173"

# SMTP (opcional). Sem SMTP_HOST, o link de reset de senha e' logado no console da API
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ContaHora <no-reply@contahora.local>"

# Porta (Railway injeta PORT automaticamente)
PORT=3000
